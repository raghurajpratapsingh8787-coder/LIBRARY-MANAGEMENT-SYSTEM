# MongoDB Connection URI (optional in local dev; defaults to embedded MongoMemoryReplSet when omitted)
MONGODB_URI=

# Comma-separated list of allowed CORS origins (defaults to current host & localhost:3000)
ALLOWED_ORIGINS=

# Optional initial Super Admin email and password for automated provisioning
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Application URL used for links and callbacks
APP_URL=http://localhost:3000
